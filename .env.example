# Порт, на котором поднимается сервер
PORT=3000

# Строка подключения к PostgreSQL. Локально — свой инстанс (например,
# postgres://v2:changeme@localhost:5432/v2), на Amvera — внутренний адрес
# сервиса БД, который Amvera показывает после создания кластера, например
# postgres://v2:<пароль>@amvera-<аккаунт>-cnpg-v2-rw:5432/v2
DATABASE_URL=postgres://v2:changeme@localhost:5432/v2?sslmode=disable

# Секрет для подписи сессионных cookie — обязательно задать в проде
# (любая случайная строка, например: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-string

# Токен бота от @BotFather — нужен для push-напоминаний (15:15 МСК)
# и еженедельных/ежемесячных отчётов. Пока пусто — уведомления
# просто не отправляются, сервер продолжает работать.
BOT_TOKEN=

# Telegram user id владельца — ему бот пишет о новых заявках на вывод
ADMIN_TG_ID=

# --- Оплата подписки через Telegram ---
# Токен платёжного провайдера из @BotFather → Bot Settings → Payments (ЮKassa)
PAYMENT_PROVIDER_TOKEN=
# RUB (по умолчанию, карта через провайдера) или XTR (Telegram Stars)
PAYMENT_CURRENCY=RUB
# Цена в звёздах, если PAYMENT_CURRENCY=XTR
STARS_PRICE_PLUS=
STARS_PRICE_PREMIUM=
# https-адрес приложения: на него ставится вебхук бота (/telegram/webhook)
# и ведёт кнопка «Открыть Version 2.0» после /start
PUBLIC_URL=
# Короткое имя Mini App из @BotFather (/newapp) — для ссылок t.me/<бот>/<имя>?startapp=КОД
MINIAPP_SHORT_NAME=
# true — «Оформить» активирует подписку сразу, без оплаты. Только локально/в тестах.
PAYMENTS_TEST_MODE=false

# --- Вывод из кошелька (15-го числа) ---
# Ключ шифрования номеров карт, 32 байта в base64: openssl rand -base64 32.
# Без ключа вывод выключен. Потеря ключа = сохранённые карты не расшифровать.
CARD_ENC_KEY=
# НДФЛ, удерживаемый с суммы вывода, % (по умолчанию 13)
TAX_WITHHOLD_PCT=13

# Разрешить запуск без реальной проверки Telegram initData (для локальной
# разработки/тестов вне Telegram). НЕ включать в проде.
DEV_ALLOW_FAKE_AUTH=true
